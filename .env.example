# Server-only contact delivery. Leave blank to keep online submission disabled.
# Never prefix these with NEXT_PUBLIC_. Use .env.local for local configuration.
RESEND_API_KEY=
# A plain email address on a domain verified in your Resend account.
CONTACT_FROM_EMAIL=
# Your actual receiving inbox. There is deliberately no default recipient.
CONTACT_TO_EMAIL=

# Optional: the public origin, e.g. https://your-portfolio-domain.example
# Useful when a reverse proxy changes the request URL seen by Next.js.
CONTACT_ALLOWED_ORIGIN=
# Optional: set ONLY if your trusted hosting proxy overwrites this IP header.
# Otherwise the endpoint uses a shared, process-local rate limit.
CONTACT_TRUSTED_IP_HEADER=
